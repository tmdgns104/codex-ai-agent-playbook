Policy removes raw unrelated_explanatory_content material from runtime adapted unit content.","source_claim_sha256":"538097d5afd5dfb6141698cdcd7b278ae12ecaeaff0c470bf95eb1c9aa451de2","source_locator":"evaluation/external-skills/snapshots/kd-sympy/SKILL.md#L90-L93"},{"category":"unrelated_explanatory_content","reason":"Policy removes raw unrelated_explanatory_content material from runtime adapted unit content.","source_claim_sha256":"e2b8e04a11f9e50bb3240eece7ef23da038176d215c4a6c71b26f93a015824d4","source_locator":"evaluation/external-skills/snapshots/kd-sympy/SKILL.md#L94-L97"},{"category":"unrelated_explanatory_content","reason":"Policy removes raw unrelated_explanatory_content material from runtime adapted unit content.","source_claim_sha256":"6bf34ad14a6db70e766cead6d05eb7b0d5367d10828ba78357dc600a8e32d537","source_locator":"evaluation/external-skills/snapshots/kd-sympy/SKILL.md#L98-L101"}],"schema_version":1,"side_effects":{"credentials":false,"external_access":false,"llm_or_ollama":false,"runtime_activation":false,"source_instruction_executed":false,"source_script_executed":false},"source":{"normalized_text_sha256":"d97b1c69fbdc20858bec83cb5542213db7a6dd9bf49c9f7c1a7f4cfdec502ef7","raw_sha256":"5445c2f5dadb95d6653681c30060b4ab9686fe02ab6729d8fc41f4a2c19a90cf","raw_utf8_bytes":9824,"trust":"UNTRUSTED_SOURCE_DATA"},"unit_provenance":[{"adapted_content_sha256":"62cc5f72e06732bc503d6df4999b40f1ae91ce9d6530f0f25d8337eee3609634","rule_id":"sympy-exact-arithmetic","source_claim":"### 3. Use Exact Arithmetic\n\n```python\nfrom sympy import Rational, S\n# Correct (exact):\nexpr = Rational(1, 2) * x\nexpr = S(1)/2 * x\n\n# Incorrect (floating-point):\nexpr = 0.5 * x  # Creates approximate value\n```","source_claim_sha256":"5900450b48778231f357eaa352aaa0c6bba01485ce20c843de3bc08863e223ea","source_locator":"evaluation/external-skills/snapshots/kd-sympy/SKILL.md#L90-L100","transformation":"EXACT_CLAIM_TO_REVIEWED_NORMALIZED_UNIT","unit_content_sha256":"8dbc19712697544f4313c99f625af08e02259d9cf8ed5a91edd48daa155e2b9e","unit_id":"kd-sympy.sympy-exact-arithmetic.ac4d1f7bfd3d121e"},{"adapted_content_sha256":"11d3961afd293744320f0df600a02913c20bb98aa2f48ffc25c36c2dc4ef6f36","rule_id":"sympy-symbol-assumptions","source_claim":"### 2. Use Assumptions for Better Simplification\n\n```python\nx = symbols('x', positive=True, real=True)\nsqrt(x**2)  # Returns x (not Abs(x)) due to positive assumption\n```","source_claim_sha256":"0c9334294fde94a77917b66aa481419a794ec838e0097d7fabfe18799fb93d63","source_locator":"evaluation/external-skills/snapshots/kd-sympy/SKILL.md#L81-L86","transformation":"EXACT_CLAIM_TO_REVIEWED_NORMALIZED_UNIT","unit_content_sha256":"280cf9003c0dcaeac581ffbaff88d3fb85399ec6ff5d50cf0b023cc8d87671ed","unit_id":"kd-sympy.sympy-symbol-assumptions.e88f7fcb50ecc2bd"},{"adapted_content_sha256":"1c813c87ec2c29b9edc588dc6976e13339d34d3dd93bdd9fd9a9568f92544188","rule_id":"sympy-solver-selection","source_claim":"### 6. Use Appropriate Solvers\n\n- `solveset`: Algebraic equations (primary)\n- `linsolve`: Linear systems\n- `nonlinsolve`: Nonlinear systems\n- `dsolve`: Differential equations\n- `solve`: General purpose (legacy, but flexible)","source_claim_sha256":"da68691cf92b441129924812315e58206a84b83b54faa9d765e587cf675a61ff","source_locator":"evaluation/external-skills/snapshots/kd-sympy/SKILL.md#L123-L129","transformation":"EXACT_CLAIM_TO_REVIEWED_NORMALIZED_UNIT","unit_content_sha256":"bbd1c0f5c7a1638f4d797cfba928dfe831d77e8c983db2366262389bd4a070b6","unit_id":"kd-sympy.sympy-solver-selection.93b3607bbe213f05"},{"adapted_content_sha256":"f593a67290af995fb365e6239c152621ee644d5384adab58dad9fd16a6e8664b","rule_id":"sympy-solve-verify","source_claim":"### Pattern 1: Solve and Verify\n\n```python\nfrom sympy import symbols, solve, simplify\nx = symbols('x')\n\n# Solve equation\nequation = x**2 - 5*x + 6\nsolutions = solve(equation, x)  # [2, 3]\n\n# Verify solutions\nfor sol in solutions:\n    result = simplify(equation.subs(x, sol))\n    assert result == 0\n```","source_claim_sha256":"0b16ddb550104c0c44c78f4e60f5770e14444a659590621775536bfab3d8e55a","source_locator":"evaluation/external-skills/snapshots/kd-sympy/SKILL.md#L152-L166","transformation":"EXACT_CLAIM_TO_REVIEWED_NORMALIZED_UNIT","unit_content_sha256":"3ff5855ae913f9a04696a19d76e847a512422bf3e3849f8000c95a649ea784a4","unit_id":"kd-sympy.sympy-solve-verify.78fc319979d733f4"},{"adapted_content_sha256":"7e7a580c8bc548f5dc330ec632744656383d7a89f2678d2273c22aebe3b002fa","rule_id":"sympy-numeric-fallback","source_claim":"### 4. Numerical Evaluation When Needed\n\n```python\nfrom sympy import pi, sqrt\nresult = sqrt(8) + pi\nresult.evalf()    # 5.96371554103586\nresult.evalf(50)  # 50 digits of precision\n```","source_claim_sha256":"144e4a86fc26751066105020f0f062808e3ed1341dded47c4adff5816fef19ce","source_locator":"evaluation/external-skills/snapshots/kd-sympy/SKILL.md#L102-L109","transformation":"EXACT_CLAIM_TO_REVIEWED_NORMALIZED_UNIT","unit_content_sha256":"b1856530490d6ce70ec9472df3f41ad8b888792e392e4aa2ba1cf3f5f007b1da","unit_id":"kd-sympy.sympy-numeric-fallback.cad63d9a4d11e3af"}]}