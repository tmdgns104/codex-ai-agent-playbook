{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/v8.4/adapted-capability-definition-v1.schema.json",
  "title": "Adapted Capability Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "adapted_capability_id",
    "version",
    "status",
    "candidate_id",
    "applicability",
    "source",
    "transformation",
    "permissions",
    "knowledge_units",
    "budget",
    "verification",
    "content_sha256",
    "cache_key"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "v8.4-adapted-capability-definition-v1"},
    "adapted_capability_id": {"$ref": "#/$defs/nonempty"},
    "version": {"$ref": "#/$defs/nonempty"},
    "status": {"enum": ["DRAFT", "APPROVED", "REJECTED", "INVALIDATED"]},
    "candidate_id": {"$ref": "#/$defs/nonempty"},
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "task_triggers", "exclusions", "prerequisites"],
      "properties": {
        "domains": {"$ref": "#/$defs/nonemptyStrings"},
        "task_triggers": {"$ref": "#/$defs/nonemptyStrings"},
        "exclusions": {"$ref": "#/$defs/strings"},
        "prerequisites": {"$ref": "#/$defs/strings"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_path", "snapshot_revision", "snapshot_sha256", "license_id", "inspection_evidence"],
      "properties": {
        "snapshot_path": {"$ref": "#/$defs/nonempty"},
        "snapshot_revision": {"$ref": "#/$defs/nonempty"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "license_id": {"$ref": "#/$defs/nonempty"},
        "inspection_evidence": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "method", "tool_or_model_id_or_null", "reviewer", "created_at_utc", "extractor_version"],
      "properties": {
        "policy_version": {"$ref": "#/$defs/nonempty"},
        "method": {"enum": ["DETERMINISTIC_EXTRACTION", "REVIEWED_ADAPTATION"]},
        "tool_or_model_id_or_null": {"anyOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]},
        "reviewer": {"$ref": "#/$defs/nonempty"},
        "created_at_utc": {"type": "string", "format": "date-time"},
        "extractor_version": {"$ref": "#/$defs/nonempty"}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_permissions", "retained_permissions", "removed_permissions", "removal_justification", "forbidden_actions", "effective_gate", "permission_policy_version"],
      "properties": {
        "source_permissions": {"$ref": "#/$defs/permissions"},
        "retained_permissions": {"$ref": "#/$defs/permissions"},
        "removed_permissions": {"$ref": "#/$defs/permissions"},
        "removal_justification": {"anyOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]},
        "forbidden_actions": {"$ref": "#/$defs/nonemptyStrings"},
        "effective_gate": {"$ref": "#/$defs/gate"},
        "permission_policy_version": {"$ref": "#/$defs/nonempty"}
      }
    },
    "knowledge_units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/knowledgeUnit"}
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utf8_bytes", "tokenizer_id_or_null", "token_count_or_null", "unavailable_reason_or_null"],
      "properties": {
        "utf8_bytes": {"type": "integer", "minimum": 0},
        "tokenizer_id_or_null": {"anyOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]},
        "token_count_or_null": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "unavailable_reason_or_null": {"anyOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_pass", "provenance_pass", "safety_pass", "fixture_pass", "holdout_pass", "fixture_evidence", "holdout_evidence"],
      "properties": {
        "schema_pass": {"$ref": "#/$defs/verdict"},
        "provenance_pass": {"$ref": "#/$defs/verdict"},
        "safety_pass": {"$ref": "#/$defs/verdict"},
        "fixture_pass": {"$ref": "#/$defs/verdict"},
        "holdout_pass": {"$ref": "#/$defs/verdict"},
        "fixture_evidence": {"$ref": "#/$defs/nonemptyStrings"},
        "holdout_evidence": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "cache_key": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "nonemptyStrings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
    "permission": {"enum": ["browser_control", "credential_access", "database_write", "destructive", "external_write", "local_read", "local_write", "network", "process_exec", "production"]},
    "permissions": {"type": "array", "items": {"$ref": "#/$defs/permission"}, "uniqueItems": true},
    "gate": {"enum": ["NONE", "AUTO_ALLOWED", "PROFILE_GATED", "NETWORK_REVIEW", "MANUAL_ONLY", "HUMAN_GATE_REQUIRED"]},
    "verdict": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "knowledgeUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "kind", "priority", "required", "task_tags", "prerequisites", "content", "source_locator", "source_claim_sha256", "content_sha256", "verification_requirements", "failure_modes", "safety_constraints"],
      "properties": {
        "unit_id": {"$ref": "#/$defs/nonempty"},
        "kind": {"enum": ["RULE", "PROCEDURE", "CHECKLIST", "EXAMPLE", "REFERENCE"]},
        "priority": {"type": "integer", "minimum": 0},
        "required": {"type": "boolean"},
        "task_tags": {"$ref": "#/$defs/nonemptyStrings"},
        "prerequisites": {"$ref": "#/$defs/strings"},
        "content": {"$ref": "#/$defs/nonempty"},
        "source_locator": {"$ref": "#/$defs/nonempty"},
        "source_claim_sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "verification_requirements": {"$ref": "#/$defs/nonemptyStrings"},
        "failure_modes": {"$ref": "#/$defs/nonemptyStrings"},
        "safety_constraints": {"$ref": "#/$defs/nonemptyStrings"}
      }
    }
  }
}
