  "high_risk_source_patterns": [
    {
      "rule_id": "source-install-command",
      "category": "install_instructions",
      "pattern": "(?i)\\b(?:uv|pip)\\s+install\\b"
    },
    {
      "rule_id": "source-script-command",
      "category": "scripts_destructive_actions",
      "pattern": "(?i)\\bpython\\s+scripts?[/\\\\]"
    },
    {
      "rule_id": "source-network-tool",
      "category": "network_credential_requirements",
      "pattern": "(?i)\\b(?:websearch|webfetch|google scholar|openalex|pubmed|crossref)\\b"
    },
    {
      "rule_id": "source-credential",
      "category": "network_credential_requirements",
      "pattern": "(?i)\\b(?:[A-Z][A-Z0-9_]*API_KEY|OPENALEX_EMAIL|NCBI_EMAIL|credential)\\b"
    },
    {
      "rule_id": "source-destructive-command",
      "category": "scripts_destructive_actions",
      "pattern": "(?i)\\b(?:rm\\s+-rf|del\\s+/[sq]|format\\s+[a-z]:)\\b"
    }
  ],
  "forbidden_adapted_content_patterns": [
    {
      "rule_id": "adapted-url",
      "pattern": "(?i)https?://"
    },
    {
      "rule_id": "adapted-install-command",
      "pattern": "(?i)\\b(?:uv|pip)\\s+install\\b"
    },
    {
      "rule_id": "adapted-script-command",
      "pattern": "(?i)\\bpython\\s+scripts?[/\\\\]"
    },
    {
      "rule_id": "adapted-network-tool",
      "pattern": "(?i)\\b(?:websearch|webfetch|curl|wget)\\b"
    },
    {
      "rule_id": "adapted-credential",
      "pattern": "(?i)\\b(?:[A-Z][A-Z0-9_]*API_KEY|api[_ -]?key|OPENALEX_EMAIL|NCBI_EMAIL|credential)\\b"
    },
    {
      "rule_id": "adapted-destructive-command",
      "pattern": "(?i)\\b(?:rm\\s+-rf|del\\s+/[sq]|format\\s+[a-z]:)\\b"
    },
    {
      "rule_id": "adapted-shell-block",
      "pattern": "(?i)```(?:bash|sh|powershell|cmd)"
    }
  ],
  "permission_signals": {
    "local_read": [
      "(?i)allowed-tools:[^\\n]*\\bread\\b"
